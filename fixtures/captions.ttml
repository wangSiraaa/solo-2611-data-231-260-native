<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:tickRate="1000"><body dur="12s"><div xml:id="parallel" begin="1s" dur="6s" timeContainer="par"><p xml:id="p1" begin="0.5s" dur="4s" xml:space="preserve">Hello <span xml:id="s1" begin="1s" dur="1.5s">world</span>!</p><p xml:id="p2" begin="2s" end="8s" xml:space="preserve"><span xml:id="s2" begin="0s" dur="2s">甲</span><span xml:id="s3" begin="1s" dur="4s">乙</span></p></div><div xml:id="sequential" begin="8s" dur="4s" timeContainer="seq"><p xml:id="p3" dur="1s" xml:space="preserve">first</p><p xml:id="p4" begin="0.25s" dur="1.5s" xml:space="preserve">second</p><p xml:id="p5" begin="0.5s" dur="2s" xml:space="preserve">clipped</p></div></body></tt>
